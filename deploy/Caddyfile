{$SERVER_NAME}, www.{$SERVER_NAME} {
    encode gzip zstd

    @api path /arbitration* /webhooks* /docs* /redoc* /openapi.json /healthz
    route {
        handle @api {
            reverse_proxy app:8000
        }

        handle {
            root * /srv/frontend
            try_files {path} /index.html
            file_server
        }
    }
}
